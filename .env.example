# Copy this file to .env. Never commit real values; docker-compose.yml reads these at runtime.

# GitHub fine-grained PAT: read-only access to your profile and repositories.
GITHUB_TOKEN=

# Microsoft Entra app registration. Redirect URI: http://localhost:8080/auth/microsoft/callback
# Delegated permission: User.Read. Application permission: User.Read.All with admin consent.
MS_TENANT_ID=
MS_CLIENT_ID=
# Treat client secrets like passwords; use the secret value, not its portal object ID.
MS_CLIENT_SECRET=

# Postman Echo accepts any configured test pair; do not reuse a real username/password.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Shared HMAC secret used only by the local webhook sender and API.
WEBHOOK_SECRET=
